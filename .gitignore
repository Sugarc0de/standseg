# Build artifacts
build/
*.o
*.ko
*.obj
*.elf
*.gch
*.pch
*.lib
*.a
*.la
*.lo
*.dll
*.so
*.so.*
*.dylib
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Program output — never write into tests/golden/
build/out/
out/
*.armap.[0-9]*
*.rmap.[0-9]*
myseg.log
regionmap
!tests/golden/**

# Python bytecode -- was tracked by mistake; .pyc embeds absolute build paths,
# is pinned to one interpreter version, and stale bytecode can shadow an edited
# source file.
__pycache__/
*.pyc

# Editor / OS
.DS_Store
*.swp
compile_commands.json
.cache/

# Claude Code local overrides
.claude/settings.local.json

# C reference build artifacts
reference/csegment/obj/
reference/csegment/bin/
reference/out/

# Rust
/target/
reference/bench/csegment_o2
reference/bench/scene*
reference/bench/*.log
reference/bench/*map.*
reference/bench/*.txt

